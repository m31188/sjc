<!-- ===== WHAT WE DO V11 - Static Left Panel + 3-Card Carousel Right (desktop) ===== -->
<% if (settings.home_show_businesses === '1' && businesses && businesses.length > 0) { %>
<section class="wwd11-section has-custom-bg" style="<%- bgStyle('whatwedo_bg_image', '', 'whatwedo_bg_opacity') %>">
  <div class="container">
    <div class="wwd11-grid">

      <!-- LEFT: Static info panel (desktop only - moves above carousel on mobile) -->
      <aside class="wwd11-info">
        <%
          const _isEn = adminLang === 'en';
          const _wwdEyebrow = (_isEn ? settings.wwd_eyebrow_en : settings.wwd_eyebrow_th) ||
                              settings.wwd_eyebrow_th || (_isEn ? 'OUR BUSINESSES' : 'ธุรกิจของเรา');
          const _wwdTitle = (_isEn ? settings.wwd_title_en : settings.wwd_title_th) ||
                            settings.wwd_title_th || (_isEn ? 'What we do' : 'สิ่งที่เราทำ');
          const _wwdCta = (_isEn ? settings.wwd_cta_en : settings.wwd_cta_th) ||
                          settings.wwd_cta_th || (_isEn ? 'Explore all businesses' : 'ดูธุรกิจทั้งหมด');
          const _wwdStat1Label = (_isEn ? settings.wwd_stat1_label_en : settings.wwd_stat1_label_th) ||
                                  settings.wwd_stat1_label_th || (_isEn ? 'Business Units' : 'หน่วยธุรกิจ');
          const _wwdStat2Value = settings.wwd_stat2_value || '50+';
          const _wwdStat2Label = (_isEn ? settings.wwd_stat2_label_en : settings.wwd_stat2_label_th) ||
                                  settings.wwd_stat2_label_th || (_isEn ? 'Years Experience' : 'ปีประสบการณ์');
        %>
        <span class="wwd11-eyebrow"><%= _wwdEyebrow %></span>
        <h2 class="wwd11-title"><%= _wwdTitle %></h2>
        <p class="wwd11-desc">
          <%= settings.business_panel_desc || (_isEn
              ? 'A diversified group driven by innovation and sustainability, delivering quality and value across multiple industries.'
              : 'กลุ่มธุรกิจหลากหลายที่ขับเคลื่อนด้วยนวัตกรรมและความยั่งยืน ส่งมอบคุณภาพและคุณค่าครอบคลุมหลายอุตสาหกรรม') %>
        </p>

        <div class="wwd11-stats">
          <div class="wwd11-stat">
            <div class="wwd11-stat-num"><%= businesses.length %>+</div>
            <div class="wwd11-stat-label"><%= _wwdStat1Label %></div>
          </div>
          <div class="wwd11-stat">
            <div class="wwd11-stat-num"><%= _wwdStat2Value %></div>
            <div class="wwd11-stat-label"><%= _wwdStat2Label %></div>
          </div>
        </div>

        <a href="/businesses" class="wwd11-cta-link">
          <%= _wwdCta %>
          <i class="fas fa-arrow-right"></i>
        </a>

        <!-- Nav arrows shown on desktop in the info panel -->
        <div class="wwd11-nav">
          <button type="button" class="wwd11-nav-prev" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>
          <button type="button" class="wwd11-nav-next" aria-label="Next"><i class="fas fa-chevron-right"></i></button>
        </div>
      </aside>

      <!-- RIGHT: 3-card carousel -->
      <div class="wwd11-carousel">
        <div class="swiper wwd11-swiper">
          <div class="swiper-wrapper">
            <% businesses.forEach((b, idx) => { %>
              <div class="swiper-slide">
                <a href="/businesses/<%= b.slug %>" class="wwd11-card">
                  <div class="wwd11-card-img">
                    <img src="<%= b.thumbnail || (settings.default_business_thumb || '/images/business-placeholder.jpg') %>"
                         alt="<%= _lf(b, 'name') %>" loading="lazy">
                    <span class="wwd11-card-num"><%= String(idx + 1).padStart(2, '0') %></span>
                  </div>
                  <div class="wwd11-card-body">
                    <h3 class="wwd11-card-title"><%= _lf(b, 'name') %></h3>
                    <% if (b.short_description) { %>
                      <p class="wwd11-card-desc"><%= _lf(b, 'short_description') %></p>
                    <% } %>
                    <span class="wwd11-card-cta">
                      <%= tUI('btn.learn_more') %>
                      <i class="fas fa-arrow-right"></i>
                    </span>
                  </div>
                </a>
              </div>
            <% }); %>
          </div>
        </div>
        <div class="wwd11-pagination"></div>
      </div>

    </div>
  </div>
</section>
<script>
(function() {
  function initWwd11() {
    if (typeof Swiper === 'undefined') return false;
    if (window.__wwd11Inited) return true;
    var container = document.querySelector('.wwd11-swiper');
    var prev = document.querySelector('.wwd11-nav-prev');
    var next = document.querySelector('.wwd11-nav-next');
    var pag = document.querySelector('.wwd11-pagination');
    if (!container) return false;
    window.__wwd11Inited = true;
    var slideCount = container.querySelectorAll('.swiper-slide').length;
    var canLoop = slideCount > 6;
    try {
      new Swiper(container, {
        slidesPerView: 1,
        spaceBetween: 16,
        grabCursor: true,
        loop: canLoop,
        loopAdditionalSlides: canLoop ? 3 : 0,
        speed: 600,
        autoplay: canLoop ? { delay: 5000, disableOnInteraction: false, pauseOnMouseEnter: true } : false,
        observer: true,
        observeParents: true,
        watchOverflow: true,
        pagination: pag ? { el: pag, clickable: true } : false,
        navigation: (prev && next) ? { prevEl: prev, nextEl: next } : false,
        breakpoints: {
          576:  { slidesPerView: 2, spaceBetween: 18 },
          900:  { slidesPerView: 3, spaceBetween: 20 }
        }
      });
    } catch(e) {
      console.error('WWD11 Swiper init failed:', e);
      window.__wwd11Inited = false;
      return false;
    }
    return true;
  }
  if (!initWwd11()) {
    window.addEventListener('load', initWwd11);
    var tries = 0;
    var iv = setInterval(function() {
      tries++;
      if (initWwd11() || tries > 50) clearInterval(iv);
    }, 100);
  }
})();
</script>
<% } %>

