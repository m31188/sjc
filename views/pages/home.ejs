<!-- ===== INVESTOR RELATIONS PANEL ===== -->
<section class="ir-panel-v3 has-custom-bg" style="<%- bgStyle('ir_bg_image', '', 'ir_bg_opacity') %>">
  <div class="section-bg-overlay"></div>
  <div class="container">
    <h2 class="ir-panel-title"><span class="ir-red">SJC</span> Investor Relations</h2>

    <div class="ir-panel-card">
      <div class="ir-panel-head"><%= adminLang === 'en' ? 'Investor Documents' : 'เอกสารเผยแพร่' %></div>
      <div class="ir-panel-list">
        <% if (typeof investorDocs !== 'undefined' && investorDocs && investorDocs.length > 0) { %>
          <% investorDocs.slice(0, 4).forEach(doc => { %>
            <a href="<%= doc.file_path || '/investor-relations' %>" class="ir-doc-row" <%= doc.file_path ? 'target="_blank"' : '' %>>
              <div class="ir-doc-title"><%= doc.title %></div>
              <div class="ir-doc-meta">
                <% if (doc.created_at) { %>
                  <%= new Date(doc.created_at).toLocaleDateString(typeof currentLang !== 'undefined' && currentLang === 'en' ? 'en-US' : 'th-TH', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                <% } %>
                <% if (doc.file_size) { %>
                  | PDF <%= (doc.file_size / 1024 / 1024).toFixed(1) %> MB
                <% } %>
              </div>
              <span class="ir-doc-btn" aria-label="<%= adminLang === 'en' ? 'Download' : 'ดาวน์โหลด' %>"><i class="fas fa-arrow-down"></i></span>
            </a>
          <% }); %>
        <% } else { %>
          <a href="/investor-relations" class="ir-doc-row">
            <div class="ir-doc-title"><%= adminLang === 'en' ? 'View all investor documents' : 'ดูเอกสารทั้งหมด' %></div>
            <span class="ir-doc-btn"><i class="fas fa-arrow-right"></i></span>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</section>

