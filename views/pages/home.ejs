<!-- Helper: pick custom bg or fallback, also expose opacity as CSS var -->
<%
function bgStyle(imgKey, fallbackColor, opacityKey) {
  var img = (settings && settings[imgKey]) ? String(settings[imgKey]) : '';
  var op = 92;
  if (opacityKey && settings && settings[opacityKey]) {
    var v = parseInt(settings[opacityKey], 10);
    if (!isNaN(v)) op = Math.max(0, Math.min(100, v));
  }
  if (img && img.trim()) {
    return "background-image: url('" + img + "'); background-size: cover; background-position: center; --bg-opacity: " + (op / 100) + ";";
  }
  if (fallbackColor) return "background: " + fallbackColor + ";";
  return '';
}
// Lang-aware field picker: returns *_en when site is in English mode, falls back to TH
const _curLang = typeof currentLang !== 'undefined' ? currentLang : 'th';
const _isEN = _curLang !== 'th';
function _lf(obj, key) {
  if (!obj) return '';
  if (_curLang !== 'th') {
    const lk = key + '_' + _curLang;
    if (obj[lk] && String(obj[lk]).trim()) return obj[lk];
  }
  return obj[key] || '';
}
%>

<!-- ===== HERO SLIDER V3 ===== -->
<% if (sliders && sliders.length > 0) { %>
<section class="hero-v3">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      <% sliders.forEach((s, i) => { %>
        <div class="swiper-slide hero-slide-v3">
          <% if (s.video_url && s.video_url.trim()) { %>
            <video class="hero-bg-video" autoplay muted loop playsinline poster="<%= s.image %>">
              <source src="<%= s.video_url %>" type="video/mp4">
            </video>
          <% } else { %>
            <!-- Desktop: CSS background. Mobile: real img scales naturally -->
            <div class="hero-bg-v3" style="background-image: url('<%= s.image %>')"></div>
            <img src="<%= s.mobile_image || s.image %>" alt="" class="hero-img-mobile">
          <% } %>
          <div class="hero-gradient-v3"></div>
          <div class="container">
            <div class="hero-content-v3 text-<%= s.text_position %>" style="color: <%= s.text_color %>">
              <% if (s.subtitle) { %>
                <div class="hero-eyebrow-v3" data-aos="fade-up"><%= s.subtitle %></div>
              <% } %>
              <% if (s.title) { %>
                <h1 class="hero-title-v3" data-aos="fade-up" data-aos-delay="100"><%= s.title %></h1>
              <% } %>
              <% if (s.description) { %>
                <p class="hero-desc-v3" data-aos="fade-up" data-aos-delay="200"><%= s.description %></p>
              <% } %>
              <% if (s.button_text && s.button_url) { %>
                <a href="<%= s.button_url %>" class="btn-hero-v3" data-aos="fade-up" data-aos-delay="300">
                  <span><%= s.button_text %></span>
                  <i class="fas fa-arrow-right"></i>
                </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="hero-controls-v3">
      <div class="container">
        <div class="hero-controls-inner">
          <button type="button" class="hero-prev-v3" aria-label="ก่อนหน้า"><i class="fas fa-chevron-left"></i></button>
          <button type="button" class="hero-next-v3" aria-label="ถัดไป"><i class="fas fa-chevron-right"></i></button>
          <div class="hero-counter">
            <span class="hero-current">01</span> / <span class="hero-total">0<%= sliders.length %></span>
          </div>
          <div class="hero-progress">
            <div class="hero-progress-bar"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>

