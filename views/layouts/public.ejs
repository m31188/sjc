       v43: FOOTER ENHANCEMENTS
       Premium polish - subtle gradients, accent line on top,
       better typography, branded social hover, animated phone
       ============================================ */
    .site-footer.footer-v3 {
      background: linear-gradient(180deg, #0d1929 0%, #050d18 100%) !important;
      position: relative !important;
    }
    /* Top accent line - thin red brand stripe */
    .site-footer.footer-v3::before {
      content: '' !important;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      height: 3px !important;
      background: linear-gradient(90deg, #c8102e 0%, #ef4444 50%, #c8102e 100%) !important;
    }
    /* Subtle decorative dot grid pattern in background */
    .site-footer.footer-v3::after {
      content: '' !important;
      position: absolute !important;
      top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.04) 1px, transparent 0) !important;
      background-size: 30px 30px !important;
      pointer-events: none !important;
      opacity: 0.6 !important;
    }
    .footer-v3-main { position: relative !important; z-index: 2 !important; }
    .footer-v3-bottom { position: relative !important; z-index: 2 !important; }
    /* Headings - bigger, more prominent */
    .footer-v3-col h4,
    .footer-v3-discover-title {
      color: #fff !important;
      font-size: 14px !important;
      font-weight: 700 !important;
      letter-spacing: 0.06em !important;
      text-transform: uppercase !important;
      margin: 0 0 22px !important;
      padding-bottom: 14px !important;
      border-bottom: 1px solid rgba(255,255,255,0.1) !important;
      position: relative !important;
    }
    .footer-v3-col h4::after,
    .footer-v3-discover-title::after {
      content: '' !important;
      position: absolute !important;
      bottom: -1px !important;
      left: 0 !important;
      width: 32px !important;
      height: 2px !important;
      background: #c8102e !important;
    }
    /* Company name in about col - SCG-like emphasis */
    .footer-v3-company {
      font-size: 17px !important;
      font-weight: 700 !important;
      color: #fff !important;
      line-height: 1.4 !important;
      margin: 0 0 14px !important;
    }
    .footer-v3-company::before {
      content: '' !important;
      display: block !important;
      width: 32px !important;
      height: 3px !important;
      background: #c8102e !important;
      margin-bottom: 12px !important;
    }
    .footer-v3-address {
      font-size: 13.5px !important;
      line-height: 1.7 !important;
      color: rgba(255,255,255,0.7) !important;
    }
    /* Phone block - more prominent */
    .footer-v3-phone-block {
      margin: 22px 0 !important;
      padding: 14px 16px !important;
      background: rgba(200,16,46,0.08) !important;
      border-left: 3px solid #c8102e !important;
      border-radius: 0 8px 8px 0 !important;
    }
    .footer-v3-phone-label {
      display: block !important;
      font-size: 10px !important;
      text-transform: uppercase !important;
      letter-spacing: 0.1em !important;
      color: rgba(255,255,255,0.55) !important;
      margin-bottom: 6px !important;
      font-weight: 600 !important;
    }
    .footer-v3-phone {
      font-size: 19px !important;
      font-weight: 700 !important;
      color: #fff !important;
      letter-spacing: 0.02em !important;
      transition: color 0.2s !important;
    }
    .footer-v3-phone:hover { color: #ef4444 !important; }
    /* Social icons - larger, branded hover with platform colors */
    .footer-v3-follow > span {
      display: block !important;
      font-size: 11px !important;
      text-transform: uppercase !important;
      letter-spacing: 0.1em !important;
      color: rgba(255,255,255,0.55) !important;
      margin-bottom: 12px !important;
      font-weight: 600 !important;
    }
    .footer-v3-social {
      display: flex !important;
      gap: 10px !important;
      flex-wrap: wrap !important;
    }
    .footer-v3-social a {
      width: 42px !important;
      height: 42px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      border-radius: 50% !important;
      background: rgba(255,255,255,0.06) !important;
      border: 1px solid rgba(255,255,255,0.1) !important;
      color: #fff !important;
      font-size: 15px !important;
      transition: all 0.3s !important;
      text-decoration: none !important;
    }
    .footer-v3-social a:hover {
      background: #c8102e !important;
      border-color: #c8102e !important;
      transform: translateY(-3px) !important;
      box-shadow: 0 8px 20px rgba(200,16,46,0.4) !important;
    }
    /* Menu links - with subtle arrow on hover */
    .footer-v3-list a {
      display: inline-flex !important;
      align-items: center !important;
      color: rgba(255,255,255,0.72) !important;
      font-size: 14px !important;
      text-decoration: none !important;
      transition: all 0.2s !important;
      padding: 4px 0 !important;
      position: relative !important;
    }
    .footer-v3-list a::before {
      content: '\f105' !important; /* fa angle-right */
      font-family: 'Font Awesome 5 Free', 'Font Awesome 6 Free' !important;
      font-weight: 900 !important;
      margin-right: 0 !important;
      width: 0 !important;
      opacity: 0 !important;
      color: #c8102e !important;
      transition: all 0.2s !important;
    }
    .footer-v3-list a:hover {
      color: #fff !important;
      padding-left: 4px !important;
    }
    .footer-v3-list a:hover::before {
      width: 14px !important;
      opacity: 1 !important;
      margin-right: 6px !important;
    }
    /* Bottom bar - cleaner separator */
    .footer-v3-bottom {
      background: rgba(0,0,0,0.4) !important;
      border-top: 1px solid rgba(255,255,255,0.08) !important;
      padding: 20px 0 !important;
    }
    .footer-v3-copyright {
      font-size: 12.5px !important;
      color: rgba(255,255,255,0.5) !important;
    }
    .footer-v3-legal a {
      font-size: 12.5px !important;
      color: rgba(255,255,255,0.55) !important;
      transition: color 0.2s !important;
      position: relative !important;
    }
    .footer-v3-legal a:hover {
      color: #fff !important;
    }
    .footer-v3-legal a + a::before {
      content: '·' !important;
      margin-right: 22px !important;
      margin-left: -16px !important;
      color: rgba(255,255,255,0.3) !important;
    }

    @media (max-width: 768px) {
      .footer-v3-main { padding: 44px 0 28px !important; }
      .footer-v3-col h4,
      .footer-v3-discover-title {
        font-size: 13px !important;
        margin-bottom: 16px !important;
        padding-bottom: 10px !important;
      }
      .footer-v3-company { font-size: 16px !important; }
      .footer-v3-phone { font-size: 17px !important; }
      .footer-v3-phone-block { padding: 12px 14px !important; margin: 18px 0 !important; }
      .footer-v3-social a { width: 38px !important; height: 38px !important; font-size: 13px !important; }
      .footer-v3-list a { font-size: 13.5px !important; }
      .footer-v3-bottom { padding: 16px 0 !important; }
    }
    @media (max-width: 992px) {
      .footer-v3-grid {
        grid-template-columns: 1fr 1fr !important;
        gap: 36px !important;
      }
      .footer-v3-col.footer-v3-about {
        grid-column: 1 / -1 !important;
      }
      .footer-v3-col:not(.footer-v3-about):not(.footer-v3-discover) > .footer-v3-list {
        padding-top: 0 !important;
      }
    }
    @media (max-width: 600px) {
      .footer-v3-main { padding: 40px 0 24px !important; }
      .footer-v3-grid {
        grid-template-columns: 1fr !important;
        gap: 28px !important;
      }
      .footer-v3-bottom-inner {
        flex-direction: column !important;
        align-items: flex-start !important;
      }
    }

    /* ============================================
       RICH CONTENT - responsive on mobile/desktop
       ============================================ */
    .rich-content {
      font-size: 16px !important;
      line-height: 1.8 !important;
      color: #374151 !important;
      word-wrap: break-word !important;
    }
    .rich-content img {
      max-width: 100% !important;
      height: auto !important;
      border-radius: 8px !important;
      margin: 20px 0 !important;
      display: block !important;
    }
    .rich-content iframe,
    .rich-content video {
      max-width: 100% !important;
      width: 100% !important;
      border-radius: 8px !important;
      margin: 20px 0 !important;
    }
    .rich-content h1,
    .rich-content h2,
    .rich-content h3,
    .rich-content h4 {
      color: #1a2540 !important;
      line-height: 1.3 !important;
      margin: 28px 0 14px !important;
      word-wrap: break-word !important;
    }
    .rich-content h2 { font-size: 26px !important; }
    .rich-content h3 { font-size: 20px !important; }
    .rich-content h4 { font-size: 17px !important; }
    .rich-content p { margin: 0 0 16px !important; }
    .rich-content ul, .rich-content ol {
      margin: 0 0 16px 20px !important;
      padding-left: 4px !important;
    }
    .rich-content li { margin-bottom: 8px !important; }
    .rich-content a {
      color: #c8102e !important;
      text-decoration: underline !important;
    }
    .rich-content blockquote {
      border-left: 4px solid #c8102e !important;
      padding: 10px 0 10px 18px !important;
      margin: 20px 0 !important;
      color: #4b5563 !important;
      font-style: italic !important;
    }
    .rich-content table {
      max-width: 100% !important;
      border-collapse: collapse !important;
      margin: 20px 0 !important;
    }
    .rich-content table th,
    .rich-content table td {
      padding: 10px 14px !important;
      border: 1px solid #e5e7eb !important;
    }
    @media (max-width: 768px) {
      .rich-content { font-size: 15px !important; line-height: 1.7 !important; }
      .rich-content h2 { font-size: 22px !important; }
      .rich-content h3 { font-size: 18px !important; }
      .rich-content h4 { font-size: 16px !important; }
      .rich-content table {
        display: block !important;
        overflow-x: auto !important;
      }
    }

    /* ============================================
       Stats: white icon by default
       ============================================ */
    .metric-v4-icon {
      color: #fff !important;
      background: rgba(255, 255, 255, 0.12) !important;
    }
    .metric-v4-large .metric-v4-icon {
      color: #fff !important;
      background: var(--primary, #c8102e) !important;
    }
    .metric-v4:hover .metric-v4-icon {
      background: var(--primary, #c8102e) !important;
      color: #fff !important;
    }
  </style>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

  <!-- Top utility bar -->
  <%- include('../partials/topbar') %>

  <!-- Header / Navigation -->
  <%- include('../partials/header') %>

  <!-- Main content -->
  <main class="main-content">
    <%- body %>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Back to top -->
  <button class="back-to-top" id="backToTop" aria-label="กลับสู่ด้านบน">
    <i class="fas fa-chevron-up"></i>
  </button>

  <!-- Google Translate removed in v33 - using native EN fields with manual translation in admin -->

  <!-- Swiper -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <!-- AOS -->
  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

  <script src="/js/main.js"></script>

  <!-- Language switcher + topbar scroll-hide (v35) -->
  <script>
  (function() {
    // ===== Mobile header lang switcher (legacy - hidden in v35 but kept for safety) =====
    const headerToggle = document.querySelector('.header-mlang-toggle');
    const headerMenu = document.querySelector('.header-mlang-menu');
    if (headerToggle && headerMenu) {
      headerToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const open = headerMenu.classList.toggle('is-open');
        headerToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // ===== Topbar lang switcher v44 - simplified, bulletproof =====
    // Logs to console so you can see if it ran
    console.log('[SJC v44] lang switcher init');

    const tbToggle = document.querySelector('.topbar-lang-toggle');
    let tbMenu = document.querySelector('.topbar-lang-dropdown');
    const tbCode = document.getElementById('topbarLangCode');
    const tbFlag = document.getElementById('topbarLangFlag');

    if (!tbToggle || !tbMenu) {
      console.warn('[SJC v44] topbar lang elements not found - skipping init');
    } else {
      // CRITICAL: Move dropdown to <body> so it escapes ALL parent
      // stacking contexts (sticky header, etc.)
      if (tbMenu.parentNode !== document.body) {
        document.body.appendChild(tbMenu);
        tbMenu.classList.add('is-portaled');
        console.log('[SJC v44] dropdown portaled to body');
      }

    // Map of code -> { label }
    const LANG_INFO = {
      th:      { label: 'ไทย' },
      en:      { label: 'English' },
      'zh-CN': { label: '中文' },
      zh:      { label: '中文' },
      'zh-TW': { label: '中文' },
      ja:      { label: '日本語' }
    };

    // Load SVG flag map from server-rendered JSON
    let FLAG_SVGS = {};
    try {
      const flagScript = document.getElementById('sjc-flag-svgs');
      if (flagScript) FLAG_SVGS = JSON.parse(flagScript.textContent || '{}');
    } catch(e) {}

    // Read current lang from googtrans cookie - handles different formats
    function getCurrentLang() {
      const cookies = document.cookie.split(';');
      for (const c of cookies) {
        const trimmed = c.trim();
        if (trimmed.startsWith('googtrans=')) {
          const value = trimmed.substring('googtrans='.length);
          const m = value.match(/\/[^/]+\/([\w-]+)/);
          if (m && m[1]) return m[1];
        }
      }
      return 'th';
    }
    function syncCurrentLabel() {
      const cur = getCurrentLang();
      const info = LANG_INFO[cur] || LANG_INFO.th;
      if (tbCode) tbCode.textContent = info.label;
      if (tbFlag && FLAG_SVGS[cur]) tbFlag.innerHTML = FLAG_SVGS[cur];
      document.querySelectorAll('.topbar-lang-option').forEach(function(o) {
        const matches = o.dataset.lang === cur ||
                        (o.dataset.lang === 'zh-CN' && (cur === 'zh' || cur === 'zh-TW'));
        o.classList.toggle('active', matches);
      });
    }
    syncCurrentLabel();

    // Position the portaled dropdown relative to the toggle.
    function positionDropdown() {
      if (!tbMenu || !tbToggle) return;
      const r = tbToggle.getBoundingClientRect();
      // Position below the toggle, aligned to its left edge.
      // Constrain right edge so it doesn't fall off-screen.
      const dropWidth = 180;
      let left = r.left;
      const maxLeft = window.innerWidth - dropWidth - 8;
      if (left > maxLeft) left = maxLeft;
      if (left < 8) left = 8;
      tbMenu.style.top = (r.bottom + 6) + 'px';
      tbMenu.style.left = left + 'px';
    }

    // Open/close the dropdown
    if (tbToggle && tbMenu) {
      const tbLang = document.getElementById('topbarLang') || tbToggle.closest('.topbar-lang');
      tbToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const willOpen = !tbMenu.classList.contains('is-open');
        if (willOpen) {
          positionDropdown();
          // FORCE inline styles so dropdown shows even if CSS fails to load.
          tbMenu.style.display = 'block';
          tbMenu.style.opacity = '1';
          tbMenu.style.visibility = 'visible';
          tbMenu.style.pointerEvents = 'auto';
          tbMenu.style.transform = 'translateY(0)';
          tbMenu.style.zIndex = '2147483647';
          tbMenu.style.position = 'fixed';
          tbMenu.style.background = '#fff';
          tbMenu.style.border = '1px solid #e5e7eb';
          tbMenu.style.borderRadius = '12px';
          tbMenu.style.boxShadow = '0 18px 48px rgba(0,0,0,0.22)';
          tbMenu.style.padding = '6px';
          tbMenu.style.minWidth = '180px';
          tbMenu.style.width = '180px';
          // Style each option inline too
          tbMenu.querySelectorAll('.topbar-lang-option').forEach(function(opt) {
            opt.style.display = 'flex';
            opt.style.alignItems = 'center';
            opt.style.gap = '12px';
            opt.style.padding = '11px 14px';
            opt.style.fontSize = '14px';
            opt.style.fontWeight = '500';
            opt.style.color = opt.classList.contains('active') ? '#fff' : '#1a2540';
            opt.style.background = opt.classList.contains('active') ? '#c8102e' : 'transparent';
            opt.style.textDecoration = 'none';
            opt.style.borderRadius = '7px';
            opt.style.cursor = 'pointer';
          });
          console.log('[SJC v45] dropdown opened at', tbMenu.style.top, tbMenu.style.left);
        } else {
          tbMenu.style.display = 'none';
        }
        tbMenu.classList.toggle('is-open', willOpen);
        if (tbLang) tbLang.classList.toggle('open', willOpen);
        tbToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });
      // Reposition on scroll/resize (since dropdown is fixed-positioned via portal)
      window.addEventListener('scroll', function() {
        if (tbMenu.classList.contains('is-open')) positionDropdown();
      }, { passive: true });
      window.addEventListener('resize', function() {
        if (tbMenu.classList.contains('is-open')) positionDropdown();
      });
    }
    document.addEventListener('click', function(e) {
      if (tbMenu && tbToggle && !tbMenu.contains(e.target) && !tbToggle.contains(e.target)) {
        if (tbMenu.classList.contains('is-open')) {
          tbMenu.classList.remove('is-open');
          tbMenu.style.display = 'none';
          const tbLang = document.getElementById('topbarLang');
          if (tbLang) tbLang.classList.remove('open');
          tbToggle.setAttribute('aria-expanded', 'false');
        }
      }
    });

    // Click a language option -> set googtrans cookie -> reload
    document.querySelectorAll('.topbar-lang-option').forEach(function(opt) {
      opt.addEventListener('click', function(e) {
        e.preventDefault();
        const target = opt.dataset.lang || 'th';
        // Build all domain variants we might need to set/clear cookies on
        // e.g. for scg.cairoit.co.th we try: scg.cairoit.co.th, .scg.cairoit.co.th,
        // .cairoit.co.th, cairoit.co.th
        const host = location.hostname;
        const domains = [host, '.' + host];
        const parts = host.split('.');
        // Add parent domains too
        for (let i = 1; i < parts.length - 1; i++) {
          domains.push('.' + parts.slice(i).join('.'));
        }
        // Always clear ALL existing googtrans cookies first
        const expire = 'expires=Thu, 01 Jan 1970 00:00:00 UTC';
        document.cookie = 'googtrans=; ' + expire + '; path=/;';
        domains.forEach(function(d) {
          document.cookie = 'googtrans=; ' + expire + '; path=/; domain=' + d + ';';
        });
        // For non-Thai, set the new cookie
        if (target !== 'th') {
          const value = '/th/' + target;
          document.cookie = 'googtrans=' + value + '; path=/;';
          domains.forEach(function(d) {
            document.cookie = 'googtrans=' + value + '; path=/; domain=' + d + ';';
          });
        }
        location.reload();
      });
    });
    } // end else (tbToggle && tbMenu found)
  })();

  // ===== Google Translate loader =====
  // Loads the translate widget asynchronously and wires it to the hidden element.
  function googleTranslateElementInit() {
    if (typeof google === 'undefined' || !google.translate) return;
    new google.translate.TranslateElement({
      pageLanguage: 'th',
      includedLanguages: 'en,zh-CN,ja,th',
      layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
      autoDisplay: false
    }, 'google_translate_element');
  }
  </script>

  <!-- Google Translate library - injected only if enable_translate setting is on -->
  <% if (typeof settings !== 'undefined' && settings.enable_translate === '1') { %>
  <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>

  <!-- Hide Google Translate UI bar that auto-injects on translated pages -->
  <style>
    /* Hide all Google Translate's own UI - we use our own dropdown */
    .goog-te-banner-frame.skiptranslate,
    .goog-te-gadget-icon,
    .goog-tooltip,
    .goog-tooltip:hover,
    #google_translate_element,
    .skiptranslate iframe,
    .goog-te-balloon-frame {
      display: none !important;
      visibility: hidden !important;
    }
    body { top: 0 !important; }
    /* Don't let Google's font selection override our own */
    .goog-text-highlight { background: transparent !important; box-shadow: none !important; }
  </style>
  <% } %>
  <!-- v46: deployment marker removed; backend-controlled now -->
</body>
</html>
