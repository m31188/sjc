<div class="page-header">
  <div>
    <h2><%= user.id ? 'แก้ไขผู้ใช้' : 'เพิ่มผู้ใช้ใหม่' %></h2>
  </div>
  <a href="/<%= adminSlug %>/users" class="btn btn-outline"><i class="fas fa-arrow-left"></i> <%= adminLang === 'en' ? 'Back' : 'กลับ' %></a>
</div>

<form method="POST" action="/<%= adminSlug %>/users<%= user.id ? '/' + user.id : '' %>">
  <div class="form-grid-narrow">
    <div class="card">
      <div class="card-body">
        <div class="form-group">
          <label>ชื่อ-นามสกุล <span class="required">*</span></label>
          <input type="text" name="name" value="<%= user.name || '' %>" required>
        </div>

        <div class="form-group">
          <label><%= adminLang === 'en' ? 'Email' : 'อีเมล' %> <span class="required">*</span></label>
          <input type="email" name="email" value="<%= user.email || '' %>" required>
        </div>

        <div class="form-group">
          <label><%= adminLang === 'en' ? 'Password' : 'รหัสผ่าน' %> <% if (!user.id) { %><span class="required">*</span><% } %></label>
          <input type="password" name="password" <%= user.id ? '' : 'required' %> placeholder="<%= user.id ? 'เว้นว่างถ้าไม่ต้องการเปลี่ยน' : 'อย่างน้อย 8 ตัวอักษร' %>">
          <small>ต้องมีอย่างน้อย 8 ตัวอักษร ผสมตัวเลขและสัญลักษณ์</small>
        </div>

        <div class="form-group">
          <label>บทบาท <span class="required">*</span></label>
          <select name="role" required>
            <option value="editor" <%= user.role === 'editor' ? 'selected' : '' %>>ผู้แก้ไข (Editor) - แก้ไขเนื้อหา</option>
            <option value="staff" <%= user.role === 'staff' ? 'selected' : '' %>>พนักงาน (Staff) - แก้ไขเนื้อหาและจัดการ</option>
            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>ผู้ดูแลระบบ (Admin) - ทุกอย่าง</option>
          </select>
        </div>

        <div class="form-group">
          <label class="check-label">
            <input type="checkbox" name="active" value="1" <%= user.active === undefined || user.active ? 'checked' : '' %>>
            <span>เปิดใช้งานบัญชีนี้</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          <i class="fas fa-save"></i> <%= adminLang === 'en' ? 'Save' : 'บันทึก' %>
        </button>
      </div>
    </div>
  </div>
</form>
