<div class="page-header">
  <div>
    <h2>จัดการผู้ใช้งาน</h2>
    <p class="text-muted">บัญชีผู้ใช้ที่สามารถเข้าระบบหลังบ้าน</p>
  </div>
  <a href="/<%= adminSlug %>/users/new" class="btn btn-primary">
    <i class="fas fa-plus"></i> <%= adminLang === 'en' ? 'Add user' : 'เพิ่มผู้ใช้' %><%= adminLang === 'en' ? 'New' : 'ใหม่' %>
  </a>
</div>

<div class="card">
  <div class="card-body p-0">
    <% if (users && users.length > 0) { %>
      <table class="data-table">
        <thead>
          <tr>
            <th><%= adminLang === "en" ? "Name" : "ชื่อ" %></th>
            <th><%= adminLang === "en" ? "Email" : "อีเมล" %></th>
            <th><%= adminLang === 'en' ? 'Role' : 'บทบาท' %></th>
            <th>เข้าระบบล่าสุด</th>
            <th width="100"><%= adminLang === "en" ? "Status" : "สถานะ" %></th>
            <th width="160"><%= adminLang === "en" ? "Actions" : "การจัดการ" %></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td>
                <strong><%= u.name %></strong>
                <% if (u.id === user.id) { %><span class="badge badge-blue">คุณ</span><% } %>
              </td>
              <td><%= u.email %></td>
              <td>
                <% const roleLabels = { admin: 'ผู้ดูแลระบบ', staff: 'พนักงาน', editor: 'ผู้แก้ไข' }; %>
                <span class="badge badge-<%= u.role === 'admin' ? 'red' : (u.role === 'staff' ? 'blue' : 'gray') %>">
                  <%= roleLabels[u.role] || u.role %>
                </span>
              </td>
              <td><small><%= u.last_login ? new Date(u.last_login).toLocaleString('th-TH') : '-' %></small></td>
              <td>
                <span class="status-badge <%= u.active ? 'active' : '' %>">
                  <%= u.active ? 'เปิด' : 'ปิด' %>
                </span>
              </td>
              <td>
                <a href="/<%= adminSlug %>/users/<%= u.id %>/edit" class="btn-icon"><i class="fas fa-edit"></i></a>
                <% if (u.id !== user.id) { %>
                  <form method="POST" action="/<%= adminSlug %>/users/<%= u.id %>/delete" class="d-inline" onsubmit="return confirm('ยืนยันลบผู้ใช้นี้?')">
                    <button type="submit" class="btn-icon btn-icon-danger"><i class="fas fa-trash"></i></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-mini">ยังไม่มีผู้ใช้</div>
    <% } %>
  </div>
</div>
