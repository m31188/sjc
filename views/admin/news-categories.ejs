<div class="page-header">
  <div>
    <h2><%= adminLang === 'en' ? 'News Categories' : 'หมวดหมู่ข่าว' %></h2>
    <p class="text-muted"><%= adminLang === 'en' ? 'Manage categories to classify news articles' : 'จัดการหมวดหมู่สำหรับจัดประเภทข่าว' %></p>
  </div>
  <a href="/<%= adminSlug %>/news" class="btn btn-outline"><i class="fas fa-arrow-left"></i> <%= adminLang === 'en' ? 'Back to news' : 'กลับไปข่าว' %></a>
</div>

<div class="form-grid">
  <div class="form-main">
    <div class="card">
      <div class="card-header"><h3><%= adminLang === 'en' ? 'Existing categories' : 'หมวดหมู่ที่มี' %></h3></div>
      <div class="card-body p-0">
        <% if (categories && categories.length > 0) { %>
          <table class="data-table">
            <thead>
              <tr>
                <th><%= adminLang === 'en' ? 'Category name' : 'ชื่อหมวดหมู่' %></th>
                <th>Slug</th>
                <th width="100"><%= adminLang === "en" ? "Actions" : "การจัดการ" %></th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(c => { %>
                <tr>
                  <td><strong><%= c.name %></strong></td>
                  <td><code><%= c.slug %></code></td>
                  <td>
                    <form method="POST" action="/<%= adminSlug %>/news-categories/<%= c.id %>/delete" class="d-inline" onsubmit="return confirm('ยืนยันลบหมวดหมู่นี้?')">
                      <button type="submit" class="btn-icon btn-icon-danger"><i class="fas fa-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <div class="empty-mini"><%= adminLang === 'en' ? 'No categories yet' : 'ยังไม่มีหมวดหมู่' %></div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="form-side">
    <div class="card">
      <div class="card-header"><h3><%= adminLang === 'en' ? 'Add category' : 'เพิ่มหมวดหมู่' %></h3></div>
      <div class="card-body">
        <form method="POST" action="/<%= adminSlug %>/news-categories">
          <div class="form-group">
            <label><%= adminLang === 'en' ? 'Category name' : 'ชื่อหมวดหมู่' %></label>
            <input type="text" name="name" required placeholder="<%= adminLang === 'en' ? 'e.g. Corporate News' : 'เช่น ข่าวบริษัท' %>">
          </div>
          <button type="submit" class="btn btn-primary btn-block">
            <i class="fas fa-plus"></i> <%= adminLang === 'en' ? 'Add category' : 'เพิ่มหมวดหมู่' %>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
