<div class="page-header">
  <div>
    <h2><%= t('careers.title') %></h2>
    <p class="text-muted"><%= adminLang === 'en' ? 'Open positions for recruitment' : 'ตำแหน่งงานที่เปิดรับสมัคร' %></p>
  </div>
  <a href="/<%= adminSlug %>/careers/new" class="btn btn-primary">
    <i class="fas fa-plus"></i> <%= t('careers.add') %>
  </a>
</div>

<div class="card">
  <div class="card-body p-0">
    <% if (jobs && jobs.length > 0) { %>
      <table class="data-table">
        <thead>
          <tr>
            <th><%= adminLang === "en" ? "Position" : "ตำแหน่ง" %></th>
            <th><%= adminLang === "en" ? "Department" : "แผนก" %></th>
            <th>สถานที่</th>
            <th><%= adminLang === 'en' ? 'Type' : 'ประเภท' %></th>
            <th width="100"><%= adminLang === "en" ? "Status" : "สถานะ" %></th>
            <th width="160"><%= adminLang === "en" ? "Actions" : "การจัดการ" %></th>
          </tr>
        </thead>
        <tbody>
          <% jobs.forEach(j => { %>
            <tr>
              <td>
                <strong><%= j.title %></strong>
                <% if (j.featured) { %><span class="badge badge-yellow">แนะนำ</span><% } %>
              </td>
              <td><%= j.department || '-' %></td>
              <td><%= j.location || '-' %></td>
              <td>
                <% const types = { 'full-time': 'งานประจำ', 'part-time': 'พาร์ทไทม์', 'contract': 'สัญญาจ้าง', 'internship': 'ฝึกงาน' }; %>
                <%= types[j.job_type] || j.job_type %>
              </td>
              <td>
                <button class="status-toggle <%= j.active ? 'active' : '' %>" data-table="careers" data-id="<%= j.id %>">
                  <%= j.active ? 'เปิดรับ' : 'ปิด' %>
                </button>
              </td>
              <td>
                <a href="/careers/<%= j.slug %>" target="_blank" class="btn-icon"><i class="fas fa-eye"></i></a>
                <a href="/<%= adminSlug %>/careers/<%= j.id %>/edit" class="btn-icon"><i class="fas fa-edit"></i></a>
                <form method="POST" action="/<%= adminSlug %>/careers/<%= j.id %>/delete" class="d-inline" onsubmit="return confirm('ยืนยันลบ?')">
                  <button type="submit" class="btn-icon btn-icon-danger"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-user-tie"></i>
        <p><%= adminLang === 'en' ? 'No jobs yet' : 'ยังไม่มีตำแหน่งงาน' %></p>
        <a href="/<%= adminSlug %>/careers/new" class="btn btn-primary">เพิ่มตำแหน่งแรก</a>
      </div>
    <% } %>
  </div>
</div>
