<div class="page-header">
  <div>
    <h2>จัดการหน้าเว็บ</h2>
    <p class="text-muted">แก้ไขเนื้อหาในหน้าหลักต่างๆ</p>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <% if (pages && pages.length > 0) { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>ชื่อหน้า</th>
            <th>URL</th>
            <th width="100"><%= adminLang === "en" ? "Status" : "สถานะ" %></th>
            <th width="120"><%= adminLang === "en" ? "Actions" : "การจัดการ" %></th>
          </tr>
        </thead>
        <tbody>
          <% pages.forEach(p => { %>
            <tr>
              <td>
                <strong><%= p.title %></strong>
                <% if (p.banner_subtitle) { %><br><small class="text-muted"><%= p.banner_subtitle %></small><% } %>
              </td>
              <td><code>/<%= p.slug %></code></td>
              <td>
                <button class="status-toggle <%= p.active ? 'active' : '' %>" data-table="pages" data-id="<%= p.id %>">
                  <%= p.active ? 'เปิด' : 'ปิด' %>
                </button>
              </td>
              <td>
                <a href="/<%= p.slug %>" target="_blank" class="btn-icon"><i class="fas fa-eye"></i></a>
                <a href="/<%= adminSlug %>/pages/<%= p.id %>/edit" class="btn-icon"><i class="fas fa-edit"></i></a>
                <a href="/<%= adminSlug %>/blocks/page/<%= p.id %>" class="btn-icon" title="<%= adminLang === 'en' ? 'Page Builder (content blocks)' : 'จัดการบล็อกเนื้อหา' %>"><i class="fas fa-th-large"></i></a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-mini">ยังไม่มีหน้าเว็บ</div>
    <% } %>
  </div>
</div>
