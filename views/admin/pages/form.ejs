<div class="page-header">
  <div>
    <h2>แก้ไขหน้า: <%= page.title %></h2>
    <p class="text-muted">URL: <code>/<%= page.slug %></code></p>
  </div>
  <div class="header-actions">
    <a href="/<%= page.slug %>" target="_blank" class="btn btn-outline"><i class="fas fa-eye"></i> ดูหน้า</a>
    <a href="/<%= adminSlug %>/pages" class="btn btn-outline"><i class="fas fa-arrow-left"></i> กลับ</a>
  </div>
</div>

<form method="POST" action="/<%= adminSlug %>/pages/<%= page.id %>" enctype="multipart/form-data">
  <div class="form-grid">
    <div class="form-main">
      <div class="card">
        <div class="card-body">
          <div class="form-group">
            <label>ชื่อหน้า <span class="required">*</span></label>
            <input type="text" name="title" value="<%= page.title || '' %>" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>หัวข้อแบนเนอร์</label>
              <input type="text" name="banner_title" value="<%= page.banner_title || '' %>">
              <small>หัวข้อใหญ่ที่แสดงในแบนเนอร์</small>
            </div>
            <div class="form-group">
              <label>คำบรรยายแบนเนอร์</label>
              <input type="text" name="banner_subtitle" value="<%= page.banner_subtitle || '' %>">
            </div>
          </div>

          <div class="form-group">
            <label>เนื้อหาหลัก</label>
            <textarea name="content" class="rich-editor" rows="15"><%= page.content || '' %></textarea>
          </div>

          <div class="card-section">
            <h4><i class="fas fa-search"></i> SEO</h4>
            <div class="form-group">
              <label>Meta Title</label>
              <input type="text" name="meta_title" value="<%= page.meta_title || '' %>">
            </div>
            <div class="form-group">
              <label>Meta Description</label>
              <textarea name="meta_description" rows="2" maxlength="160"><%= page.meta_description || '' %></textarea>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="form-side">
      <div class="card">
        <div class="card-body">
          <button type="submit" class="btn btn-primary btn-block">
            <i class="fas fa-save"></i> บันทึก
          </button>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h4>รูปแบนเนอร์</h4>
          <div class="image-hint">
            <i class="fas fa-info-circle"></i>
            <strong>ขนาดที่แนะนำ:</strong> 1920×500px<br>
            แบนเนอร์ด้านบนสุดของหน้า
          </div>
          <% if (page.banner_image) { %>
            <div class="current-image"><img src="<%= page.banner_image %>" alt=""></div>
          <% } %>
          <label class="upload-area">
            <input type="file" name="banner_image" accept="image/*">
            <i class="fas fa-cloud-upload-alt"></i>
            <span>เลือกรูป</span>
          </label>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  tinymce.init({
    selector: '.rich-editor',
    height: 500,
    plugins: 'lists link image media table code preview fullscreen',
    toolbar: 'undo redo | blocks | bold italic | forecolor | alignleft aligncenter alignright | bullist numlist | link image | code fullscreen',
    images_upload_url: '/api/upload-image',
    images_upload_handler: function (blobInfo) {
      return new Promise((resolve, reject) => {
        const fd = new FormData();
        fd.append('file', blobInfo.blob(), blobInfo.filename());
        fetch('/api/upload-image', { method: 'POST', body: fd })
          .then(r => r.json()).then(d => d.location ? resolve(d.location) : reject('Upload failed'));
      });
    }
  });
</script>
