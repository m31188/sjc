<div class="page-header">
  <div>
    <h2><i class="fas fa-users"></i> ใบสมัครงาน / Job Applications</h2>
    <p class="text-muted">รายการใบสมัครงานทั้งหมด</p>
  </div>
</div>

<div class="apps-tabs">
  <% const tabs = [
    { key: 'all', label: 'ทั้งหมด' },
    { key: 'new', label: 'ใหม่' },
    { key: 'reviewing', label: 'กำลังพิจารณา' },
    { key: 'contacted', label: 'ติดต่อแล้ว' },
    { key: 'hired', label: 'จ้างแล้ว' },
    { key: 'rejected', label: 'ไม่ผ่าน' }
  ]; %>
  <% tabs.forEach(tab => { %>
    <a href="?status=<%= tab.key %>" class="apps-tab <%= currentStatus === tab.key ? 'active' : '' %>">
      <%= tab.label %>
      <% if (counter[tab.key]) { %><span class="apps-tab-count"><%= counter[tab.key] %></span><% } %>
    </a>
  <% }); %>
</div>

<% if (applications.length === 0) { %>
  <div class="card">
    <div class="card-body text-center" style="padding: 60px 20px;">
      <i class="fas fa-inbox" style="font-size: 48px; color: #d1d5db; margin-bottom: 16px;"></i>
      <p class="text-muted"><%= adminLang === 'en' ? 'No applications yet' : 'ยังไม่มีใบสมัคร' %></p>
    </div>
  </div>
<% } else { %>
  <div class="card">
    <table class="table table-apps">
      <thead>
        <tr>
          <th><%= adminLang === 'en' ? 'Applicant' : 'ผู้สมัคร' %></th>
          <th>ตำแหน่งงาน</th>
          <th>ติดต่อ</th>
          <th>ไฟล์</th>
          <th><%= adminLang === "en" ? "Status" : "สถานะ" %></th>
          <th>วันที่สมัคร</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% applications.forEach(app => { %>
          <tr>
            <td>
              <div class="apps-name"><%= app.full_name %></div>
              <div class="apps-email-sm"><%= app.email %></div>
            </td>
            <td>
              <%= app.job_title || app.current_job_title || '-' %>
              <% if (app.career_slug) { %>
                <a href="/careers/<%= app.career_slug %>" target="_blank" class="apps-job-link"><i class="fas fa-external-link-alt"></i></a>
              <% } %>
            </td>
            <td>
              <% if (app.phone) { %>
                <a href="tel:<%= app.phone %>"><i class="fas fa-phone"></i> <%= app.phone %></a>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td>
              <% if (app.resume_path) { %>
                <a href="<%= app.resume_path %>" target="_blank" class="apps-resume-btn">
                  <i class="fas fa-file-pdf"></i> Resume
                </a>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </td>
            <td>
              <span class="apps-status apps-status-<%= app.status %>"><%
                const labels = {
                  'new': 'ใหม่',
                  'reviewing': 'กำลังพิจารณา',
                  'contacted': 'ติดต่อแล้ว',
                  'rejected': 'ไม่ผ่าน',
                  'hired': 'จ้างแล้ว'
                };
              %><%= labels[app.status] || app.status %></span>
            </td>
            <td><%= formatThaiDate(app.created_at, { short: true }) %></td>
            <td>
              <a href="/<%= adminSlug %>/applications/<%= app.id %>" class="btn btn-sm btn-outline">
                <i class="fas fa-eye"></i> <%= adminLang === 'en' ? 'View' : 'ดู' %>
              </a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
