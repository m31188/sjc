<header class="site-header header-v3" id="siteHeader">
  <div class="container">
    <div class="header-inner-v3">
      <a href="/" class="logo">
        <span class="logo-img-wrap">
          <img src="<%= settings.site_logo || '/images/logo-placeholder.png' %>" alt="<%= settings.site_name || 'SJC' %>" class="logo-default">
          <% if (settings.logo_badge_enabled === '1' && settings.logo_badge_text) { %>
            <span class="logo-badge-corner" title="<%= settings.logo_badge_text %>"><%= settings.logo_badge_text %></span>
          <% } %>
        </span>
      </a>

      <!-- Mobile-only language switcher - shown in main header next to hamburger -->
      <% if (settings.enable_translate === '1') { %>
      <div class="header-mobile-lang">
        <button type="button" class="header-mlang-toggle" aria-label="Language" aria-expanded="false">
          <i class="fas fa-globe" style="font-size:12px;"></i>
          <span class="header-mlang-code"><%= (typeof currentLang !== 'undefined' && currentLang === 'en') ? 'EN' : 'TH' %></span>
        </button>
        <div class="header-mlang-menu">
          <a href="?lang=th" data-lang="th" class="<%= (typeof currentLang === 'undefined' || currentLang !== 'en') ? 'active' : '' %>">
            <span class="lang-flag">🇹🇭</span> ไทย
          </a>
          <a href="?lang=en" data-lang="en" class="<%= (typeof currentLang !== 'undefined' && currentLang === 'en') ? 'active' : '' %>">
            <span class="lang-flag">🇬🇧</span> English
          </a>
        </div>
      </div>
      <% } %>

      <!-- Desktop nav links inline -->
      <nav class="desktop-nav main-nav-v3-desktop" id="desktopNav">
        <ul class="nav-list">
          <% headerMenu.filter(m => !m.parent_id).forEach(item => { %>
            <% const children = headerMenu.filter(c => c.parent_id === item.id); %>
            <li class="nav-item <%= children.length > 0 ? 'has-dropdown' : '' %>">
              <a href="<%= item.url %>" class="nav-link <%= currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url)) ? 'active' : '' %>" <%= item.open_new_tab ? 'target="_blank"' : '' %>>
                <%= item.label %>
                <% if (children.length > 0) { %><i class="fas fa-chevron-down nav-chev"></i><% } %>
              </a>
              <% if (children.length > 0) { %>
                <ul class="nav-dropdown">
                  <% children.forEach(c => { %>
                    <li><a href="<%= c.url %>" <%= c.open_new_tab ? 'target="_blank"' : '' %>><%= c.label %></a></li>
                  <% }); %>
                </ul>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </nav>

      <div class="header-actions">
        <button class="search-toggle" id="searchToggle" aria-label="<%= tUI('btn.search') %>">
          <i class="fas fa-search"></i>
        </button>
        <button class="nav-toggle" id="navToggle" aria-label="เปิดเมนู">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Search overlay -->
  <div class="search-overlay" id="searchOverlay">
    <div class="container">
      <button class="search-close" id="searchClose" aria-label="ปิด"><i class="fas fa-times"></i></button>
      <form action="/news" method="GET" class="search-form">
        <input type="text" name="q" placeholder="<%= tUI('btn.search') + '...' %>" class="search-input" autofocus>
        <button type="submit" class="search-submit"><i class="fas fa-search"></i></button>
      </form>
    </div>
  </div>
</header>

<!-- MOBILE MENU - OUTSIDE the header to escape its stacking context -->
<nav class="main-nav main-nav-v3" id="mainNav">
  <button class="nav-close" id="navClose" aria-label="ปิดเมนู"><i class="fas fa-times"></i></button>
  <ul class="nav-list">
    <% headerMenu.filter(m => !m.parent_id).forEach(item => { %>
      <% const children = headerMenu.filter(c => c.parent_id === item.id); %>
      <li class="nav-item <%= children.length > 0 ? 'has-mobile-sub' : '' %>">
        <% if (children.length > 0) { %>
          <div class="nav-mobile-row">
            <a href="<%= item.url %>" class="nav-link <%= currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url)) ? 'active' : '' %>" <%= item.open_new_tab ? 'target="_blank"' : '' %>>
              <%= item.label %>
            </a>
            <button type="button" class="nav-mobile-toggle" aria-label="Expand submenu" aria-expanded="false">
              <i class="fas fa-chevron-down"></i>
            </button>
          </div>
          <ul class="nav-mobile-sub">
            <% children.forEach(c => { %>
              <li><a href="<%= c.url %>" <%= c.open_new_tab ? 'target="_blank"' : '' %>><%= c.label %></a></li>
            <% }); %>
          </ul>
        <% } else { %>
          <a href="<%= item.url %>" class="nav-link <%= currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url)) ? 'active' : '' %>" <%= item.open_new_tab ? 'target="_blank"' : '' %>>
            <%= item.label %>
          </a>
        <% } %>
      </li>
    <% }); %>
  </ul>
</nav>

<div class="nav-backdrop" id="navBackdrop"></div>
