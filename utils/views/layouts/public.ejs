<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

  <!-- Top utility bar -->
  <%- include('../partials/topbar') %>

  <!-- Header / Navigation -->
  <%- include('../partials/header') %>

  <!-- Main content -->
  <main class="main-content">
    <%- body %>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Back to top -->
  <button class="back-to-top" id="backToTop" aria-label="กลับสู่ด้านบน">
    <i class="fas fa-chevron-up"></i>
  </button>

  <!-- Google Translate removed in v33 - using native EN fields with manual translation in admin -->

  <!-- Swiper -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <!-- AOS -->
  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

  <script src="/js/main.js"></script>

  <!-- Language switcher + topbar scroll-hide (v35) -->
  <script>
  (function() {
    // ===== Mobile header lang switcher (legacy - hidden in v35 but kept for safety) =====
    const headerToggle = document.querySelector('.header-mlang-toggle');
    const headerMenu = document.querySelector('.header-mlang-menu');
    if (headerToggle && headerMenu) {
      headerToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const open = headerMenu.classList.toggle('is-open');
        headerToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // ===== Topbar lang switcher (used on both mobile and desktop) =====
    const tbToggle = document.querySelector('.topbar-lang-toggle');
    const tbMenu = document.querySelector('.topbar-lang-dropdown');
    if (tbToggle && tbMenu) {
      tbToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const open = tbMenu.classList.toggle('is-open');
        tbToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // Close any open dropdown on outside click
    document.addEventListener('click', function(e) {
      [headerMenu, tbMenu].forEach(function(m) {
        if (!m) return;
        const associatedToggle = m === headerMenu ? headerToggle : tbToggle;
        if (!m.contains(e.target) && associatedToggle && !associatedToggle.contains(e.target)) {
          m.classList.remove('is-open');
          associatedToggle.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // ===== Hide topbar on scroll down, show on scroll up (mobile only) =====
    const topbar = document.querySelector('.topbar, .topbar-v3');
    if (topbar && window.matchMedia('(max-width: 768px)').matches) {
      let lastY = window.scrollY;
      let ticking = false;
      window.addEventListener('scroll', function() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function() {
          const y = window.scrollY;
          if (y > 60 && y > lastY) {
            // scrolling down past 60px -> hide
            topbar.classList.add('is-hidden');
          } else if (y < lastY - 5) {
            // scrolling up by 5px -> show
            topbar.classList.remove('is-hidden');
          }
          lastY = y;
          ticking = false;
        });
      }, { passive: true });
    }
  })();
  </script>
</body>
